<script>
    function changerStyle() {
        let paragraphe = document.getElementById("monParagraphe");
        paragraphe.style.fontSize = "30px";
        paragraphe.style.fontStyle = "italic";
        paragraphe.style.color = "red";
    }

    function remettreStyle() {
        let paragraphe = document.getElementById("monParagraphe");
        paragraphe.style.fontSize = "16px";
        paragraphe.style.fontStyle = "normal";
        paragraphe.style.color = "black";
    }
</script>