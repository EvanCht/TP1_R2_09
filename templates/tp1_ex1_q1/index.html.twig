{% extends 'base.html.twig' %}

{% block title %}Hello TP1Ex1Q1Controller!{% endblock %}

{% block body %}
    <div class="example-wrapper">
        <h1>Hello {{ date|date('d/m/Y H:i:s') }} !</h1>
    </div>

    <h1>Formulaire</h1>

    <form method="post" action="{{ path('tp1_ex1_q1_result') }}">
        <label for="prenom">Prénom :</label>
        <input type="text" id="prenom" name="prenom" required>

        <br><br>

        <label for="nom">Nom :</label>
        <input type="text" id="nom" name="nom" required>

        <br><br>

        <button type="submit">Envoyer</button>
    </form>
    
    <h1>Calcul de l'âge</h1>
    <button onclick="demanderAge()">Calculer mon âge</button>
    <p id="id_Age"></p>

    <h1>Exercice 2.2</h1>

    <p id="monParagraphe" onmouseover="changerStyle()" onmouseout="remettreStyle()">
        Passez la souris sur ce texte pour modifier son apparence.
    </p>

    <h1>Liste des BUT de l'IUT de Roanne</h1>

    <ul id="listeBUT">
        <li>BUT RT</li>
        <li>BUT GIM</li>
        <li>BUT GEA</li>
        <li>BUT GACO</li>
        <li>BUT TC</li>
    </ul>

    <button onclick="ajouterElement()">Ajouter un BUT</button>
    <button onclick="supprimerElement()">Supprimer le dernier BUT</button>

    
    <a href="{{ path('tp1_ex1_q1_jquery') }}">
        <button>jQuery</button>
    </a>

    <button onclick="window.location.href='{{ path('connexion') }}'">
        Connexion
    </button>

{% endblock %}

{% block javascripts %}
    {% include 'tp1_ex1_q1/2_1.html.twig' %}

    {% include 'tp1_ex1_q1/2_2.html.twig' %}

    {% include 'tp1_ex1_q1/2_3.html.twig' %}
{% endblock %}