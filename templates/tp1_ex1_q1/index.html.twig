        <h1>Hello {{ date|date('d/m/Y H:i:s') }} !</h1>
    </div>

    <h1>Formulaire</h1>

    <form method="post" action="{{ path('tp1_ex1_q1_result') }}">
        <label for="prenom">Prénom :</label>
        <input type="text" id="prenom" name="prenom" required>

        <br><br>

